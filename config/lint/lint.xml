<?xml version="1.0" encoding="UTF-8"?>
<!--
  MultiStore lint policy.

  Rule 1: no hardcoded user-visible strings, in any language. `HardcodedText` covers XML;
  `MultiStoreComposeHardcodedText` (a custom check in :lint-rules) covers composables, which
  is where essentially all of this project's UI lives.
-->
<lint>
    <issue id="HardcodedText" severity="error" />
    <issue id="MultiStoreComposeHardcodedText" severity="error" />

    <!-- Parity across the 5 languages: TranslationParityTest is the strong check,
         these issues are the safety net inside the IDE. -->
    <issue id="MissingTranslation" severity="error" />
    <issue id="ExtraTranslation" severity="error" />
    <issue id="ImpliedQuantity" severity="error" />

    <!-- MultiStore is not distributed on the Play Store: these do not apply. -->
    <issue id="GoogleAppIndexingWarning" severity="ignore" />
    <issue id="UnusedResources" severity="ignore" />
</lint>
