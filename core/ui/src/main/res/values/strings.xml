<?xml version="1.0" encoding="utf-8"?>
<!--
  Text shared by several features: the error vocabulary and the labels of an app's list row.

  It lives here rather than in a feature because the same sentence must say the same thing in
  search, on the Home and on the detail page. Written together with the other 4 languages:
  TranslationParityTest fails the build if a key is missing from one of them.
-->
<resources>
    <!-- Errors: one for each AppError case, no more and no less. -->
    <string name="error_network">No connection. Check the network and try again.</string>
    <string name="error_rate_limited">The store is asking us to slow down. Try again shortly.</string>
    <string name="error_blocked">The store blocked the request.</string>
    <string name="error_parse">The store answered in an unexpected format.</string>
    <string name="error_not_found">Not found on this store.</string>
    <string name="error_integrity">An integrity check failed. The file was discarded.</string>
    <string name="error_storage">Not enough space, or the file could not be written.</string>
    <string name="error_install_failed">The system refused the installation.</string>
    <string name="error_cancelled">Cancelled.</string>
    <string name="error_user_assistance_disabled">This download needs a tap on the store page, and that path is turned off in Settings.</string>
    <string name="error_unexpected">Something went wrong.</string>
    <!-- Actions shared by several screens. -->
    <string name="action_back">Back</string>
    <string name="install_failed_unknown">The system refused the installation and did not say why.</string>
    <string name="install_failed_blocked">Something above Android refused: a device policy, a security app, or a feature of the %1$s software. Android’s own setting is not where to look.</string>
    <string name="install_failed_blocked_generic">Something above Android refused: a device policy, a security app, or a feature of the manufacturer’s software.</string>
    <string name="install_failed_invalid">The file is not a valid APK. It is almost always an interrupted download: try downloading it again.</string>
    <string name="install_failed_conflict">It clashes with the copy already installed: a different signature, or an older version. Uninstalling the installed app first resolves it, and loses its data.</string>
    <string name="install_failed_storage">Not enough space on the device.</string>
    <string name="install_failed_incompatible">The app does not run on this device: it needs a newer Android, or a processor architecture this device does not have.</string>
    <string name="install_failed_timeout">The system took too long. Trying again usually works.</string>

    <!-- The progress card that appears above every screen. -->
    <string name="downloads_overlay_title_one">Downloading %1$s</string>
    <string name="downloads_overlay_unknown_app">an app</string>
    <string name="downloads_overlay_dismiss">Hide the download panel</string>
    <string name="downloads_overlay_expand">Open the downloads screen</string>
    <plurals name="downloads_overlay_title_many">
        <item quantity="one">Downloading %1$d app</item>
        <item quantity="other">Downloading %1$d apps</item>
    </plurals>
    <plurals name="downloads_overlay_ready">
        <item quantity="one">%1$d app ready to install</item>
        <item quantity="other">%1$d apps ready to install</item>
    </plurals>

    <!-- The screenshot strip and its full-screen reader. -->
    <string name="gallery_screenshot_position">Screenshot %1$d of %2$d</string>
    <string name="gallery_close">Close the screenshot</string>
    <string name="gallery_position">%1$d / %2$d</string>

    <!-- The "update everything" panel, drawn on the Home and in "My apps". -->
    <string name="update_all_action">Update all</string>
    <string name="update_all_applying">Updating %1$d of %2$d</string>
    <string name="update_all_finished">%1$d updated, %2$d not done</string>
    <string name="update_all_dismiss">OK</string>
    <plurals name="update_all_title">
        <item quantity="one">%1$d update available</item>
        <item quantity="other">%1$d updates available</item>
    </plurals>

    <!-- The order of the installed list. Shared by Settings and by the list itself: one wording, two places. -->
    <string name="myapps_sort_name">Name</string>
    <string name="myapps_sort_updatable">Updatable first</string>
    <string name="myapps_sort_recent">Recently installed</string>
    <string name="myapps_sort_store">Store it came from</string>

    <!-- The rework badge: five stores of nine redistribute APKs somebody other than the
         developer has changed. The two labels are the two declarations that exist; the dialog says
         what the pre-install check can and cannot prove about such a file. -->
    <string name="modified_build_declared_label">Modified build</string>
    <string name="modified_build_possible_label">May be modified</string>
    <string name="modified_build_badge_action">What this means</string>
    <string name="modified_build_dialog_title">About this build</string>
    <string name="modified_build_dialog_declared">%1$s says this file is a rework: somebody other than the developer changed the app and republished it.</string>
    <string name="modified_build_dialog_possible">%1$s redistributes reworked apps, and does not say whether this one is. It may be the developer’s build, or somebody else’s.</string>
    <string name="modified_build_dialog_verified">What the check before installing can prove: that the file is a valid, signed archive, that the package name matches the one this listing declares, and — where the store publishes a hash — that the bytes are the ones it announced.</string>
    <string name="modified_build_dialog_unverified">What it cannot prove: that the app has not been altered by whoever republished it. A rework has no original developer signature to compare against, so there is nothing to check it against.</string>
    <string name="modified_build_dialog_dismiss">Got it</string>

    <!-- A store's health, in a sentence (0.8.0). It lives here because two screens ask the
         same question — Settings and the search's shortfall notice — and a `:feature:*`
         never depends on another, so this is the only place they can share the wording. -->
    <string name="store_diagnosis_state_ok">This store is answering normally.</string>
    <string name="store_diagnosis_state_open">This store is paused after repeated failures. It will be tried again by itself.</string>
    <string name="store_diagnosis_state_half_open">This store is about to be tried again: the next request is a probe.</string>
    <string name="store_diagnosis_state_degraded">This store answers, but its pages are not being read as expected.</string>
    <string name="store_diagnosis_failing_for">It has been failing for %1$s.</string>
    <string name="store_diagnosis_last_success">It last answered %1$s ago.</string>
    <string name="store_diagnosis_never_answered">It has never answered on this device.</string>
    <string name="store_diagnosis_fault_transient">Last fault: no connection, a timeout, or an error from the site. These usually clear by themselves.</string>
    <string name="store_diagnosis_fault_rate_limited">Last fault: the store asked to be queried less often. This clears by itself, and waiting is the only thing that helps.</string>
    <string name="store_diagnosis_fault_blocked">Last fault: the store refused the request. This does not clear by waiting, and insisting makes it worse.</string>
    <string name="store_diagnosis_fault_parse">Last fault: the page was not in the expected shape. This is the app’s side, not the store’s — waiting will not fix it.</string>
    <string name="store_diagnosis_parse_selectors">Parts that could not be read: %1$s</string>
    <string name="store_diagnosis_dismiss">Close</string>
    <plurals name="store_diagnosis_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <plurals name="store_diagnosis_hours">
        <item quantity="one">%1$d hour</item>
        <item quantity="other">%1$d hours</item>
    </plurals>
    <plurals name="store_diagnosis_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
</resources>
