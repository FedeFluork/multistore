    <!-- Updates. -->
    <string name="myapps_action_check">Rechercher des mises à jour</string>
    <string name="myapps_checking">Recherche de mises à jour…</string>
    <string name="myapps_check_dismiss">OK</string>
    <string name="myapps_update_available">Mise à jour disponible : %1$s</string>
    <string name="myapps_update_paused">Mises à jour en pause</string>
    <string name="myapps_update_paused_with_pending">Mises à jour en pause — une version plus récente est sortie</string>
    <string name="myapps_update_pinned">Verrouillée au code de version %1$d — %2$s est sortie</string>
