<?xml version="1.0" encoding="utf-8"?>
<!--
  The browse-a-store's-catalogue screen.

  Written together with the other 4 languages: a key may never be added to one language alone,
  and TranslationParityTest fails the build if that happens.

  Category names are NOT here: the store publishes them, already localised.
-->
<resources>
    <string name="storelisting_all_categories">All</string>
    <string name="storelisting_load_more">Load more</string>
    <string name="storelisting_empty_title">Nothing in this category</string>
    <string name="storelisting_empty_message">The downloaded catalogue has no app here. Try another category, or sync again from the home screen.</string>
    <string name="storelisting_choose_category">Choose a category</string>
    <plurals name="storelisting_category_app_count">
        <item quantity="one">%1$d app</item>
        <item quantity="other">%1$d apps</item>
    </plurals>
</resources>
