    <string name="appdetail_permissions_expand">Afficher les %1$d</string>
    <string name="appdetail_permissions_collapse">Afficher moins</string>

    <!-- Changing which store an installed app updates from (0.8.0). The column has existed
         since M3 and no screen changed it. The warning is shown **before** the switch, not
         after: a signer that differs makes the update impossible, and finding out later
         costs a download and a refusal about the archive. -->
    <string name="appdetail_channel_title">La mettre à jour d’ici</string>
    <string name="appdetail_channel_message">Cette application se met à jour depuis %1$s. Désormais elle se mettrait à jour depuis ce magasin — l’application installée n’est pas touchée, et sa provenance reste enregistrée.</string>
    <string name="appdetail_channel_signer_warning">La signature sur ce magasin n’est pas celle de votre copie installée. Android refuse une mise à jour dont le signataire a changé : la seule issue serait de désinstaller l’application et d’en perdre les données.</string>
    <string name="appdetail_channel_action">Mettre à jour d’ici</string>

