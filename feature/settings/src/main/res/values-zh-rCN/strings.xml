    <string name="settings_config_refresh_label">检查新配置</string>
    <string name="settings_config_refresh_description">现在检查，不必等到下一次计划检查。收到的配置会从下次启动起使用。</string>
    <string name="settings_config_refresh_action">立即检查</string>
    <string name="settings_config_refresh_blocked">配置更新已关闭。</string>
    <string name="settings_section_content">内容</string>
    <string name="settings_content_nsfw_label">显示NSFW内容</string>
    <string name="settings_content_nsfw_description">关闭后，结果会排除商店标记为成人的内容。只有一家商店会标记，而且标记并不完整：此开关只隐藏商店声明的内容，不代表隐藏它提供的全部内容。</string>
    <string name="settings_store_modyolo_description">修改版构建，元数据在改版来源中较完整，但二进制文件质量较差：约四分之一的文件已失效并返回服务器错误，因此 MultiStore 会在下载前确认文件存在。它通过 Google Play 链接发布包名，但不发布校验和。它也是唯一标记成人内容的商店，NSFW 开关只依据该标记。</string>
    <string name="settings_store_an1_description">修改版和原版并列提供。网站任何页面都不发布包名，因此 MultiStore 无法确认实际安装的是哪个应用，只能依据标题和开发者匹配。部分文件提供校验和，提供时会进行完整验证。</string>
    <string name="settings_store_pdalife_description">修改版（“Money Mod”“Mod Menu”“Premium”）与原版并列，并提供大量旧版本。它不发布校验和，因此下载只能与包名比对；大多数应用会声明包名。文件位于需要你自行打开并点击的页面中，请留意页面上可能有外观像下载按钮的广告。</string>
    <string name="settings_store_liteapks_description">提供“MOD”“Premium”“Paid”等修改版，部分页面还会同时提供 Google Play 原版文件。它不发布校验和，因此下载只能与包名比对；大多数应用会声明包名。搜索最多返回 60 个结果。自有文件位于一键下载页面，原版文件位于有时会失效的独立主机上。</string>
    <string name="settings_block_remote_index_label">拒绝我们发布的应用索引</string>
    <string name="settings_block_remote_index_description">首页的“最热门”和“最新内容”来自我们签名并发布的索引。开启后将停止下载该索引：首页仍使用本地目录，其他功能不受影响。</string>
    <string name="settings_block_self_update_label">不检查MultiStore更新</string>
    <string name="settings_block_self_update_description">MultiStore 不在任何商店中，新版本会在同一索引中发布。下载的更新会经过与其他应用相同的检查，包括签名比对。</string>
    <string name="settings_section_search">搜索</string>
    <string name="settings_search_timeout_label">等待商店的时间</string>
    <string name="settings_search_timeout_description">商店不会同时响应：有的几毫秒就能读取本地索引，有的要等三秒后才适合发起请求。超时的商店会和其他结果一起标为缺失，搜索不会一直等它。</string>
    <string name="settings_search_timeout_dialog_title">等待商店的时间</string>
    <plurals name="settings_search_timeout_seconds">
        <item quantity="one">%1$d 秒</item>
        <item quantity="other">%1$d 秒</item>
    </plurals>
    <string name="settings_search_field_label">搜索设置</string>
    <string name="settings_search_field_clear">清除搜索</string>
    <string name="settings_search_empty_title">没有匹配项</string>
    <string name="settings_search_empty_message">没有设置包含这些词。试试只输入一个词，或清空输入框查看全部设置。</string>
    <string name="settings_section_notifications">通知</string>
    <string name="settings_notify_download_label">下载完成时通知</string>
    <string name="settings_notify_download_description">仅适用于 MultiStore 自动开始的下载。你主动请求的文件会在应用页面显示进度，通知不会提供额外信息。</string>
    <string name="settings_notify_install_label">无人值守安装完成时通知</string>
    <string name="settings_notify_install_description">仅适用于 MultiStore 自动执行的安装。最值得关注的是失败：例如签名变更导致更新被拒绝，这种失败不会自动重试。</string>
    <string name="settings_notify_store_label">商店未响应时通知</string>
    <string name="settings_notify_store_description">仅用于定期检查；被查询的商店正是已安装应用的更新来源。因此，沉默的商店意味着应用会悄悄停止更新。搜索时，未响应的商店已经显示在结果旁边。</string>
    <string name="settings_section_diagnostics">诊断</string>
    <string name="settings_diagnostics_log_label">还记录成功的请求</string>
    <string name="settings_diagnostics_log_description">MultiStore 始终记录失败信息。开启后还会记录成功请求：每次请求的完整地址、响应码和耗时。部分商店会把搜索词放在地址中。记录只保存在本设备，只有导出时才会离开设备。</string>
    <string name="settings_diagnostics_export_label">导出诊断报告</string>
    <string name="settings_diagnostics_export_description">写入包含应用版本、设备、各商店状态、当前配置和记录事件的文本文件。发送前请先阅读；如果开启上面的开关，还会包含 MultiStore 请求过的地址。</string>
    <string name="settings_diagnostics_export_action">导出</string>
    <string name="settings_diagnostics_export_done">报告已保存。</string>
    <string name="settings_diagnostics_export_failed">无法保存报告。</string>
    <string name="settings_search_sort_label">默认排序顺序</string>
    <string name="settings_search_sort_description">在单次搜索单独更改排序前，结果默认按此方式排列。可选条件只有三个：所有商店都有标题，三家商店有评分，没有一家商店为每条结果都提供日期。</string>
    <string name="settings_search_sort_relevance">相关性</string>
    <string name="settings_search_sort_name">名称</string>
    <string name="settings_search_sort_rating">评分</string>
    <string name="settings_search_content_kind_label">默认显示</string>
    <string name="settings_search_content_kind_description">搜索默认从应用、游戏还是全部开始。只有一家商店会为条目分类，因此选择类型后，其他商店会被排除，并在结果下方说明。</string>
    <string name="settings_search_content_kind_all">全部</string>
    <string name="settings_search_content_kind_apps">仅应用</string>
    <string name="settings_search_content_kind_games">仅游戏</string>
    <string name="settings_storage_catalog_label">已下载的目录</string>
    <string name="settings_storage_catalog_description">保存在设备上的应用页面、版本和截图，以及发布本地索引的商店的完整索引。清空它释放空间最多，重建成本也最高：仅 F-Droid 就要重新下载约 18 MB。已安装应用、更新渠道和跨商店匹配都会保留。</string>
    <string name="settings_storage_apks_label">已下载的 APK</string>
    <string name="settings_storage_apks_description">设备上保留的安装文件：未安装的下载，以及由下方设置保留的文件。正在进行或暂停的传输不会受影响。</string>
    <string name="settings_storage_images_label">图片</string>
    <string name="settings_storage_images_description">应用图标和截图。下次滚动列表时会自动重新加载。</string>
    <string name="settings_storage_pages_label">商店页面</string>
    <string name="settings_storage_pages_description">保存原始页面，这样返回刚看过的结果时无需再次请求商店。清空后，每个重新访问的页面都会额外消耗一次请求。</string>
    <string name="settings_storage_clear_action">清空</string>
    <string name="settings_storage_clearing">清空…</string>
    <string name="settings_storage_freed">已释放 %1$s。</string>
    <string name="settings_storage_nothing">没有可释放的空间。</string>
    <string name="settings_storage_catalog_confirm_title">清空下载的目录？</string>
    <string name="settings_storage_catalog_confirm_message">重新下载前，在本地索引商店中将搜索不到任何内容；F-Droid 约需 18 MB，使用当时的网络连接下载。已安装应用和更新渠道会保留。</string>
    <string name="settings_storage_confirm_cancel">取消</string>
    <string name="settings_keep_apk_label">安装后保留 APK</string>
    <string name="settings_keep_apk_description">关闭后，安装成功就会删除安装文件。开启后，文件会保留并重复使用，再次安装同一版本无需下载，但占用空间会持续增加；只有清空按钮能释放这些空间。</string>
    <string name="settings_catalog_retention_label">保留过期的商店页面</string>
    <string name="settings_catalog_retention_description">商店自身的有效期到期后会重新获取页面；这里设置旧副本保留多久，让你重新打开昨天的搜索时能立即看到内容。本设置不影响本地索引商店：它们保存的是你主动下载的目录，不是过期页面。</string>
    <string name="settings_catalog_retention_dialog_title">保留过期页面</string>
    <string name="settings_catalog_retention_7_days">7 天</string>
    <string name="settings_catalog_retention_30_days">30 天</string>
    <string name="settings_catalog_retention_90_days">90 天</string>
    <string name="settings_catalog_retention_keep">永久</string>
    <string name="settings_image_cache_label">图片缓存大小</string>
    <string name="settings_image_cache_description">设置图标和截图最多占用的磁盘空间。下次启动应用时生效，因为缓存打开后大小就会固定。</string>
    <string name="settings_image_cache_dialog_title">图片缓存大小</string>
    <string name="settings_unknown_sources_label">允许安装应用程序</string>
    <string name="settings_unknown_sources_description">需要告知 Android 允许 MultiStore 安装应用。这是系统设置，可以在应用外部撤销，包括系统更新后被撤销。</string>
    <string name="settings_unknown_sources_action">打开设置</string>
    <string name="settings_unknown_sources_granted">允许</string>
    <string name="settings_unknown_sources_denied">不允许</string>
    <string name="settings_unknown_sources_unreachable">此设备没有该设置页面：%1$s 软件可能已移动或删除此选项。请在系统设置中搜索“安装未知应用”。</string>
    <string name="settings_section_support">支持</string>
    <string name="settings_donate_description">MultiStore 免费、无广告，也不会向外发送数据。如果它对你有帮助，欢迎捐赠以支持项目继续维护。捐赠页面会在浏览器中打开。</string>
    <string name="settings_donate_kofi_label">在 Ko-fi 捐赠</string>
    <string name="settings_donate_kofi_action">打开 Ko-fi</string>
    <string name="settings_donate_paypal_label">在 PayPal 捐赠</string>
    <string name="settings_donate_paypal_action">打开 PayPal</string>
    <string name="settings_auto_install_after_download_label">下载后立即提供安装</string>
    <string name="settings_auto_install_after_download_description">下载完成且你已离开应用页面后，MultiStore 会自动打开系统安装提示。关闭后，文件会留在“下载”中等待你处理。它可能打断你在应用中的操作，也不会用于自动更新检查获取的文件（如果自动安装已关闭）。</string>
    <string name="settings_auto_install_after_download_silent">你选择的安装方式无需此选项：它可以直接安装，不会弹出确认。</string>
    <string name="settings_download_history_label">保留下载历史</string>
    <string name="settings_download_history_description">下载页面记住多少条已完成下载：已安装、失败和已删除的记录。进行中的传输和等待安装的文件不会计入，也不会被移除。</string>
    <string name="settings_download_history_dialog_title">保留下载历史</string>
    <string name="settings_download_history_50">最近 50 条</string>
    <string name="settings_download_history_100">最近 100 条</string>
    <string name="settings_download_history_500">最近 500 条</string>
    <string name="settings_download_history_all">全部保留</string>
    <string name="settings_storage_apks_confirm_title">删除下载的文件？</string>
    <string name="settings_storage_apks_confirm_message">这会删除仍保留在设备上的安装文件。正在进行或已暂停的传输不会受影响。</string>
    <plurals name="settings_storage_apks_confirm_ready">
        <item quantity="one">%1$d 个应用已准备安装并将被删除；之后需要重新下载。正在进行或暂停的传输会保留。</item>
        <item quantity="other">%1$d 个应用已准备安装并将被删除；之后需要重新下载。正在进行或暂停的传输会保留。</item>
    </plurals>
    <string name="settings_section_my_apps">我的应用</string>
    <string name="settings_my_apps_sort_label">列表顺序</string>
    <string name="settings_my_apps_sort_description">通过 MultiStore 安装的应用如何排列。只影响列表顺序，不影响更新。</string>
    <string name="settings_search_history_label">不保留最近的搜索</string>
    <string name="settings_search_history_description">搜索框为空时会显示最近十次搜索。开启后将停止记录，并忘记已有记录。它们不会离开设备。</string>
