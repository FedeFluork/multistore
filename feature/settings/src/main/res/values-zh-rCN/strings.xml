    <string name="settings_section_security">安全</string>
    <string name="settings_section_network">网络</string>
    <string name="settings_allow_unverified_hash_label">安装时跳过校验和检查</string>
    <string name="settings_allow_unverified_hash_description">即使商店发布的校验和与下载文件不匹配，也继续安装。建议关闭：不匹配表示文件不是商店描述的文件。开启后应用仍会安装，但验证卡会显示“未验证哈希”。</string>
    <string name="settings_allow_signer_mismatch_label">使用意外签名安装</string>
    <string name="settings_allow_signer_mismatch_description">即使 APK 没有使用商店声明的密钥签名，也继续安装。它不适用于已用其他密钥安装的应用：Android 仍会拒绝更新，唯一办法是卸载再安装，但会丢失数据。关闭此开关时，MultiStore 也会让你逐个应用做出选择。</string>
    <string name="settings_metered_network_label">使用按流量计费的连接</string>
    <string name="settings_metered_network_description">也通过移动数据下载商店目录和应用文件。完整的 F-Droid 目录约为 18 MB。关闭时，MultiStore 会在开始前询问。</string>
    <string name="settings_challenge_strategy_label">商店要求验证时</string>
    <string name="settings_challenge_strategy_description">有些商店会返回浏览器可以自动通过的验证，不需要验证码或点击。MultiStore 可以在隐藏的浏览器视图中运行它：页面会真实执行，不会伪造。请选择应用可以自动执行到哪一步。</string>
    <string name="settings_challenge_strategy_dialog_title">商店要求验证时</string>
    <string name="settings_challenge_strategy_balanced">在隐藏视图中运行验证</string>
    <string name="settings_challenge_strategy_conservative">仅使用网络，不打开浏览器视图</string>
    <string name="settings_challenge_strategy_aggressive">运行验证，并持续尝试更长时间</string>
    <string name="settings_challenge_user_assisted_label">永远不要打开商店页面让我点击</string>
    <string name="settings_challenge_user_assisted_description">两家商店只有在你真实点击其页面后才会移交文件。MultiStore 会在应用内打开页面，因此文件仍会在安装前经过全部检查。开启后不会提供这些下载。</string>
    <string name="settings_allow_web_ads_label">允许商店页面中出现广告</string>
    <string name="settings_allow_web_ads_description">辅助下载会打开商店自己的页面，其中广告是提供恶意软件的最常见方式。MultiStore 会删除已知广告和跟踪主机的请求。Cloudflare 和 reCAPTCHA 永远不会被丢弃，因此打开此功能不会解锁因挑战而停滞的下载。</string>
    <string name="settings_section_storage">存储</string>
    <string name="settings_reclaim_space_label">回收空间</string>
    <string name="settings_reclaim_space_description">压缩目录数据库并清空写入日志。它不会删除你能看到的内容：目录、已安装应用和设置都会保留。完整同步 F-Droid 后，数据库约占 65 MB。</string>
    <string name="settings_reclaim_space_action">立即回收</string>
    <string name="settings_reclaim_space_running">正在压缩…</string>
    <string name="settings_reclaim_space_freed">已释放 %1$s。</string>
    <string name="settings_reclaim_space_nothing">无需回收空间，数据库已经是紧凑状态。</string>
    <string name="settings_section_stores">商店</string>
    <string name="settings_stores_description">MultiStore 会搜索所选商店。关闭某个商店后，它不会出现在结果中，也不会再向它发送请求。</string>
    <string name="settings_stores_choose_label">选择商店</string>
    <string name="settings_stores_active_count">已启用 %1$d / %2$d 家</string>
