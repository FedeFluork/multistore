    <string name="settings_section_configuration">远程配置</string>
    <string name="settings_config_block_label">拒绝配置更新</string>
    <string name="settings_config_block_description">MultiStore 会下载一个包含选择器和地址的小型签名文件，用来读取各商店页面；页面变化时无需发布新版本即可修复。开启后只使用应用内置的配置。</string>
