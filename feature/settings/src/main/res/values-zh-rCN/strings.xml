    <string name="settings_stores_tab_original">原版</string>
    <string name="settings_stores_tab_modified">修改版</string>
    <string name="settings_stores_save">保存</string>
    <string name="settings_store_state_open">暂时无法访问 — MultiStore 将自行重试。</string>
    <string name="settings_store_state_degraded">商店有响应，但页面已变化，结果可能不完整。</string>
    <string name="settings_store_f_droid_description">仅提供免费开源应用。发布签名目录、每个版本的校验和以及预期签名密钥，因此下载可以端到端验证。</string>
    <string name="settings_store_apkcombo_description">镜像 Google Play 应用。不发布校验和，因此 MultiStore 只能确认包名匹配，不能确认文件就是条目所描述的文件。</string>
    <string name="settings_store_apkmirror_description">经过人工审核的镜像，禁止盗版。它发布每个文件的校验和和签名证书，因此下载验证与 F-Droid 一样完整。</string>
    <string name="settings_store_apkmody_description">修改版构建，解锁高级功能。它发布包名但不发布校验和；修改版由修改者签名，因此 MultiStore 只能确认你安装的是哪个应用，不能确认文件没有被改动。</string>
    <string name="settings_store_uptodown_description">通用镜像，每个文件都有已发布的校验和，因此下载是端到端验证的。文件本身经过人工检查：MultiStore 打开商店页面，然后点击“下载”。</string>
    <string name="settings_section_updates">更新</string>
    <string name="settings_update_interval_label">检查更新</string>
    <string name="settings_update_interval_description">设置 MultiStore 检查你从这里安装的应用是否有新版本的频率。</string>
    <string name="settings_update_interval_dialog_title">检查更新</string>
    <string name="settings_update_interval_manual">仅在我手动检查时</string>
    <string name="settings_update_interval_6_hours">每 6 小时</string>
    <string name="settings_update_interval_12_hours">每 12 小时</string>
    <string name="settings_update_interval_daily">每天一次</string>
    <string name="settings_update_interval_weekly">每周一次</string>
    <string name="settings_update_charging_label">仅在充电时</string>
    <string name="settings_update_charging_description">推迟自动检查，直到设备插入电源。</string>
    <string name="settings_update_manual_unavailable">仅适用于自动检查，该检查处于关闭状态。</string>
    <string name="settings_update_auto_download_label">自动下载更新</string>
    <string name="settings_update_auto_download_description">发现更新后立即获取 APK，让安装只需点击一次。按流量计费的连接会等待下载，除非你在“网络”中允许。</string>
    <string name="settings_update_auto_install_label">自动安装更新</string>
    <string name="settings_preview_channels_label">包括预览频道</string>
    <string name="settings_preview_channels_description">如果商店发布 beta、alpha 或 RC 构建，也一并提供。首次安装和更新都适用。若只想临时安装一个预览版本，请在应用页面打开“以前的版本”。</string>
    <string name="settings_update_auto_install_description">无需询问即可下载并安装。验证方式与手动点击“安装”时完全相同。</string>
    <string name="settings_update_auto_install_no_silent">需要 Shizuku 或 root。没有它们，Android 必须在每次安装前询问你，而且应用在后台时无法询问。</string>
    <string name="settings_update_mute_label">静默更新通知</string>
    <string name="settings_update_mute_description">继续检查，但不要发布通知。可用的更新仍列在主屏幕上。</string>
    <string name="settings_section_installation">安装</string>
    <string name="settings_installer_label">安装方法</string>
    <string name="settings_installer_description">负责将安装包写入系统。系统确认始终有效；如果有 Shizuku 或 root，可免确认安装。</string>
    <string name="settings_installer_dialog_title">安装方法</string>
    <string name="settings_installer_option_automatic">自动</string>
    <string name="settings_installer_option_session">系统确认</string>
