<?xml version="1.0" encoding="utf-8"?>
<!--
  The window's XML theme.

  It exists only for what comes *before* Compose: the window background and the splash screen. The
  app's real palette is :core:designsystem's — these two colours exist because the system draws the
  window before our code runs, and they must match `background` in the two ColorSchemes, otherwise a
  flash of the wrong colour shows at startup.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MultiStore" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <style name="Theme.MultiStore.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- White foreground on indigo: maximum contrast, identical in both themes. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MultiStore</item>
    </style>

</resources>
